#: admin/class-asl-admin.php:159
msgid "All search logs have been deleted."
msgstr "همه گزارش‌های جستجو حذف شدند."

#: admin/class-asl-admin.php:160
msgid "Rule saved. It applies to new searches immediately."
msgstr "قانون ذخیره شد و از همین حالا روی جستجوهای جدید اعمال می‌شود."

#. translators: %s: number
#: admin/class-asl-admin.php:162
#, php-format
msgid "%s rule deleted."
msgid_plural "%s rules deleted."
msgstr[0] "%s قانون حذف شد."

#: admin/class-asl-admin.php:163
msgid "Rules updated."
msgstr "قوانین به‌روزرسانی شدند."

#: admin/class-asl-admin.php:165
msgid "Marked as resolved. It will reappear only if it fails again."
msgstr ""
"به‌عنوان «رفع‌شده» علامت خورد. فقط اگر دوباره بی‌نتیجه بماند، برمی‌گردد."

#: admin/class-asl-admin.php:166
