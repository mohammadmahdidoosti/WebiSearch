#. Plugin Name of the plugin
#: advanced-search-logger.php
msgid "WebiSearch"
msgstr "WebiSearch"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: advanced-search-logger.php
msgid "https://webiloper.ir/"
msgstr "https://webiloper.ir/"

#. Description of the plugin
#: advanced-search-logger.php
msgid ""
"Search analytics for any WordPress site: logs standard, AJAX and live "
"searches, measures result clicks and WooCommerce conversions, finds failed "
"searches and fixes them with synonyms and redirects."
msgstr ""
"تحلیل جستجوی سایت برای هر سایت وردپرسی: ثبت جستجوهای معمولی، ایجکس و زنده، "
"سنجش کلیک روی نتایج و فروش ووکامرس، پیدا کردن جستجوهای بی‌نتیجه و رفع آن‌ها "
"با مترادف و تغییر مسیر."

#. Author of the plugin
#: advanced-search-logger.php
msgid "webiloper"
msgstr "وبیلوپر"

